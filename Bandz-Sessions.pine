//@version=6
// Bandz Session Ranges + ORG + Opening Prices
// Reorganized from the user's Bandz Levels and Bandz ORG indicators.
indicator(title="Bandz Session Ranges + ORG + Opening Prices", shorttitle="Bandz Sessions", overlay=true, max_bars_back=5000, max_lines_count=500, max_labels_count=500, max_boxes_count=500, dynamic_requests=true)

// ============================================================================
// =========================  QUICK ORG TOGGLE  ===============================
// ============================================================================

org_group_main = "ORG - Opening RTH Gap"

org_show = input.bool(
     false,
     "Show ORG",
     group=org_group_main)

// =====================  ORG — OPENING RTH GAP + STDV  ======================
// ============================================================================
// Correct STDV logic:
// +0.5 STDV = ORG high + one-half ORG range
// -0.5 STDV = ORG low  - one-half ORG range
// +1 STDV   = ORG high + one complete ORG range
// -1 STDV   = ORG low  - one complete ORG range
//
// Example gap down:
// Prior close = 20,000
// 9:30 open  = 19,950
// ORG size   = 50
// +1 STDV    = 20,050
// -1 STDV    = 19,900
//
// Displays only on 1m, 2m, and 3m charts.

org_group_style  = "ORG - Line Style"
org_group_stdv   = "ORG - STDV Projections"
org_group_labels = "ORG - Labels / Buffer"

// ============================================================================
// INPUTS
// ============================================================================
// Show ORG is declared at the very top of the script so it stays first.

org_close_basis = input.string(
     "CME Futures 16:14",
     "Prior RTH Close Source",
     options=[
         "CME Futures 16:14",
         "US Equities 15:59"
     ],
     group=org_group_main,
     tooltip="Use CME Futures 16:14 for instruments such as ES, NQ, YM, and RTY. Use US Equities 15:59 for regular US stocks.")

org_large_gap_ticks = input.int(
     100,
     "Large Gap Threshold (ticks)",
     minval=1,
     group=org_group_main,
     tooltip="Large gaps show 9:30 Open, Prior Close, 25%, 50%, and 75%. Small gaps show 9:30 Open, Prior Close, and 50%.")

org_sessions_to_keep = input.int(
     1,
     "ORG Sessions to Keep",
     minval=1,
     maxval=5,
     group=org_group_main,
     tooltip="Controls how many completed ORG sessions remain on the chart.")

// ============================================================================
// ORG LINE STYLE
// ============================================================================

org_open_color = input.color(
     color.black,
     "9:30 Open",
     inline="ORGENDS",
     group=org_group_style)

org_close_color = input.color(
     color.black,
     "Prior RTH Close",
     inline="ORGENDS",
     group=org_group_style)

org_internal_color = input.color(
     color.black,
     "25 / 50 / 75",
     group=org_group_style)

org_line_style_txt = input.string(
     "Dashed",
     "ORG Style",
     options=[
         "Solid",
         "Dotted",
         "Dashed"
     ],
     inline="ORGS",
     group=org_group_style)

org_line_width = input.int(
     1,
     "Width",
     minval=1,
     maxval=4,
     inline="ORGS",
     group=org_group_style)

// ============================================================================
// STDV STYLE
// ============================================================================

org_max_deviation = input.int(
     5,
     "Maximum STDV",
     minval=1,
     maxval=10,
     group=org_group_stdv,
     tooltip="Starts with +0.5 and -0.5. Touching either visible level reveals +1/-1, then each next whole-number pair.")

org_up_color = input.color(
     color.rgb(242, 54, 69),
     "+STDV",
     inline="ORGDEV",
     group=org_group_stdv)

org_down_color = input.color(
     color.rgb(41, 98, 255),
     "-STDV",
     inline="ORGDEV",
     group=org_group_stdv)

org_dev_style_txt = input.string(
     "Dotted",
     "STDV Style",
     options=[
         "Solid",
         "Dotted",
         "Dashed"
     ],
     inline="ORGDEVS",
     group=org_group_stdv)

org_dev_width = input.int(
     1,
     "Width",
     minval=1,
     maxval=4,
     inline="ORGDEVS",
     group=org_group_stdv)

// ============================================================================
// LABELS AND BUFFER
// ============================================================================

org_show_labels = input.bool(
     true,
     "Show ORG Labels",
     inline="ORGL",
     group=org_group_labels)

org_label_color = input.color(
     color.black,
     "",
     inline="ORGL",
     group=org_group_labels)

org_label_size_txt = input.string(
     "Tiny",
     "Label Size",
     options=[
         "Tiny",
         "Small",
         "Normal",
         "Large"
     ],
     group=org_group_labels)

org_right_buffer = input.int(
     8,
     "ORG Right Buffer (Bars)",
     minval=0,
     maxval=500,
     group=org_group_labels,
     tooltip="Pushes active ORG line ends and labels this many chart bars to the right.")

// ============================================================================
// STYLE FUNCTIONS
// ============================================================================

org_get_line_style(string _style) =>
    switch _style
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_dotted

org_get_label_size(string _size) =>
    switch _size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        "Large"  => size.large
        => size.tiny

// ============================================================================
// EXACT 1-MINUTE ORG DATA
// ============================================================================

org_get_930_open_1m() =>
    bool _is930 =
         hour(time, "America/New_York") == 9 and
         minute(time, "America/New_York") == 30

    ta.valuewhen(_is930, open, 0)

org_get_930_time_1m() =>
    bool _is930 =
         hour(time, "America/New_York") == 9 and
         minute(time, "America/New_York") == 30

    ta.valuewhen(_is930, time, 0)

org_get_close_at_time_1m(int _hour, int _minute) =>
    bool _isCloseBar =
         hour(time, "America/New_York") == _hour and
         minute(time, "America/New_York") == _minute

    ta.valuewhen(_isCloseBar, close, 0)

org_get_rth_high_1m(int _sessionEndMinute) =>
    int _minuteOfDay =
         hour(time, "America/New_York") * 60 +
         minute(time, "America/New_York")

    bool _is930 =
         _minuteOfDay == 570

    bool _insideRth =
         _minuteOfDay >= 570 and
         _minuteOfDay < _sessionEndMinute

    var float _sessionHigh = na

    if _is930
        _sessionHigh := high
    else if _insideRth
        _sessionHigh := na(_sessionHigh) ?
             high :
             math.max(_sessionHigh, high)

    _sessionHigh

org_get_rth_low_1m(int _sessionEndMinute) =>
    int _minuteOfDay =
         hour(time, "America/New_York") * 60 +
         minute(time, "America/New_York")

    bool _is930 =
         _minuteOfDay == 570

    bool _insideRth =
         _minuteOfDay >= 570 and
         _minuteOfDay < _sessionEndMinute

    var float _sessionLow = na

    if _is930
        _sessionLow := low
    else if _insideRth
        _sessionLow := na(_sessionLow) ?
             low :
             math.min(_sessionLow, low)

    _sessionLow

// Exact 9:30 open and time.

float org_feed_930_open = request.security(
     syminfo.tickerid,
     "1",
     org_get_930_open_1m(),
     barmerge.gaps_off,
     barmerge.lookahead_off)

int org_feed_930_time = request.security(
     syminfo.tickerid,
     "1",
     org_get_930_time_1m(),
     barmerge.gaps_off,
     barmerge.lookahead_off)

// Both possible close sources are calculated.
// The selected setting determines which one is used.

float org_feed_close_1614 = request.security(
     syminfo.tickerid,
     "1",
     org_get_close_at_time_1m(16, 14),
     barmerge.gaps_off,
     barmerge.lookahead_off)

float org_feed_close_1559 = request.security(
     syminfo.tickerid,
     "1",
     org_get_close_at_time_1m(15, 59),
     barmerge.gaps_off,
     barmerge.lookahead_off)

// CME session continues through the 16:14 bar.
// Equity RTH ends after the 15:59 bar.

float org_feed_cme_high = request.security(
     syminfo.tickerid,
     "1",
     org_get_rth_high_1m(975),
     barmerge.gaps_off,
     barmerge.lookahead_off)

float org_feed_cme_low = request.security(
     syminfo.tickerid,
     "1",
     org_get_rth_low_1m(975),
     barmerge.gaps_off,
     barmerge.lookahead_off)

float org_feed_equity_high = request.security(
     syminfo.tickerid,
     "1",
     org_get_rth_high_1m(960),
     barmerge.gaps_off,
     barmerge.lookahead_off)

float org_feed_equity_low = request.security(
     syminfo.tickerid,
     "1",
     org_get_rth_low_1m(960),
     barmerge.gaps_off,
     barmerge.lookahead_off)

bool org_use_cme_close =
     org_close_basis == "CME Futures 16:14"

float org_feed_rth_close =
     org_use_cme_close ?
     org_feed_close_1614 :
     org_feed_close_1559

float org_feed_rth_high =
     org_use_cme_close ?
     org_feed_cme_high :
     org_feed_equity_high

float org_feed_rth_low =
     org_use_cme_close ?
     org_feed_cme_low :
     org_feed_equity_low

// ============================================================================
// ARRAYS AND CURRENT-SESSION STATE
// ============================================================================

var line[] org_all_lines       = array.new_line()
var label[] org_all_labels     = array.new_label()
var int[] org_day_line_counts  = array.new_int()
var int[] org_day_label_counts = array.new_int()

var float org_current_open       = na
var float org_current_close      = na
var float org_current_gap_size   = na
var float org_current_range_high = na
var float org_current_range_low  = na

var int org_current_open_time  = na
var float org_revealed_deviation = 0.0

var bool org_current_valid        = false
var bool org_current_is_large_gap = false

// ============================================================================
// OBJECT STORAGE
// ============================================================================

org_store_line(
     line[] _allLines,
     int[] _dayCounts,
     line _newLine) =>

    array.unshift(_allLines, _newLine)

    if array.size(_dayCounts) > 0
        array.set(
             _dayCounts,
             0,
             array.get(_dayCounts, 0) + 1)

org_store_label(
     label[] _allLabels,
     int[] _dayCounts,
     label _newLabel) =>

    array.unshift(_allLabels, _newLabel)

    if array.size(_dayCounts) > 0
        array.set(
             _dayCounts,
             0,
             array.get(_dayCounts, 0) + 1)

// ============================================================================
// CREATE ONE HORIZONTAL LEVEL
// ============================================================================

org_add_level(
     line[] _allLines,
     label[] _allLabels,
     int[] _lineCounts,
     int[] _labelCounts,
     int _startTime,
     int _endTime,
     float _price,
     string _text,
     color _lineColor,
     string _styleText,
     int _lineWidth,
     bool _showLabel,
     color _labelColor,
     string _labelSizeText) =>

    if not na(_price)
        line _newLine = line.new(
             _startTime,
             _price,
             _endTime,
             _price,
             xloc=xloc.bar_time,
             color=_lineColor,
             style=org_get_line_style(_styleText),
             width=_lineWidth)

        org_store_line(
             _allLines,
             _lineCounts,
             _newLine)

        if _showLabel
            label _newLabel = label.new(
                 _endTime,
                 _price,
                 _text,
                 xloc=xloc.bar_time,
                 style=label.style_label_left,
                 color=color.new(color.black, 100),
                 textcolor=_labelColor,
                 size=org_get_label_size(_labelSizeText))

            org_store_label(
                 _allLabels,
                 _labelCounts,
                 _newLabel)

// ============================================================================
// CREATE CORRECT STDV PAIR
// ============================================================================

org_deviation_text(float _deviation) =>
    _deviation == math.floor(_deviation) ?
         str.tostring(int(_deviation)) :
         str.tostring(_deviation)

org_add_deviation_pair(
     line[] _allLines,
     label[] _allLabels,
     int[] _lineCounts,
     int[] _labelCounts,
     int _startTime,
     int _endTime,
     float _rangeHigh,
     float _rangeLow,
     float _gapSize,
     float _deviation,
     color _upColor,
     color _downColor,
     string _styleText,
     int _lineWidth,
     bool _showLabel,
     color _labelColor,
     string _labelSizeText) =>

    // Correct logic:
    // Project upward from the ORG high.
    // Project downward from the ORG low.

    float _upper =
         _rangeHigh +
         (_gapSize * _deviation)

    float _lower =
         _rangeLow -
         (_gapSize * _deviation)

    org_add_level(
         _allLines,
         _allLabels,
         _lineCounts,
         _labelCounts,
         _startTime,
         _endTime,
         _upper,
         "+" + org_deviation_text(_deviation) + " STDV",
         _upColor,
         _styleText,
         _lineWidth,
         _showLabel,
         _labelColor,
         _labelSizeText)

    org_add_level(
         _allLines,
         _allLabels,
         _lineCounts,
         _labelCounts,
         _startTime,
         _endTime,
         _lower,
         "-" + org_deviation_text(_deviation) + " STDV",
         _downColor,
         _styleText,
         _lineWidth,
         _showLabel,
         _labelColor,
         _labelSizeText)

// ============================================================================
// DELETE OLD ORG SESSIONS
// ============================================================================

org_delete_old_sessions(
     line[] _allLines,
     label[] _allLabels,
     int[] _lineCounts,
     int[] _labelCounts,
     int _sessionsToKeep) =>

    while array.size(_lineCounts) > _sessionsToKeep
        int _oldLineCount =
             array.pop(_lineCounts)

        if _oldLineCount > 0
            for _i = 0 to _oldLineCount - 1
                if array.size(_allLines) > 0
                    line _oldLine =
                         array.pop(_allLines)

                    line.delete(_oldLine)

    while array.size(_labelCounts) > _sessionsToKeep
        int _oldLabelCount =
             array.pop(_labelCounts)

        if _oldLabelCount > 0
            for _i = 0 to _oldLabelCount - 1
                if array.size(_allLabels) > 0
                    label _oldLabel =
                         array.pop(_allLabels)

                    label.delete(_oldLabel)

// ============================================================================
// TIMEFRAME RESTRICTION
// ============================================================================

bool org_valid_chart =
     timeframe.isminutes and
     timeframe.multiplier >= 1 and
     timeframe.multiplier <= 3

int org_chart_bar_ms =
     org_valid_chart ?
     math.max(
         1000,
         int(timeframe.in_seconds(timeframe.period) * 1000)) :
     60000

int org_active_end_time =
     time +
     (org_chart_bar_ms * org_right_buffer)

// ============================================================================
// DETECT NEW 9:30 ORG
// ============================================================================

bool org_new_rth_open =
     org_show and
     org_valid_chart and
     not na(org_feed_930_time) and
     (
         na(org_feed_930_time[1]) or
         org_feed_930_time != org_feed_930_time[1]
     )

// ============================================================================
// CREATE NEW ORG
// ============================================================================

if org_new_rth_open
    org_current_open      := org_feed_930_open
    org_current_close     := org_feed_rth_close
    org_current_gap_size  := math.abs(
         org_current_open -
         org_current_close)

    org_current_range_high := math.max(
         org_current_open,
         org_current_close)

    org_current_range_low := math.min(
         org_current_open,
         org_current_close)

    org_current_open_time  := org_feed_930_time
    org_revealed_deviation := 0.0

    org_current_valid :=
         not na(org_current_open) and
         not na(org_current_close) and
         not na(org_current_range_high) and
         not na(org_current_range_low) and
         org_current_gap_size >= syminfo.mintick

    if org_current_valid
        array.unshift(
             org_day_line_counts,
             0)

        array.unshift(
             org_day_label_counts,
             0)

        float org_gap_signed =
             org_current_open -
             org_current_close

        float org_25 =
             org_current_close +
             (org_gap_signed * 0.25)

        float org_50 =
             org_current_close +
             (org_gap_signed * 0.50)

        float org_75 =
             org_current_close +
             (org_gap_signed * 0.75)

        float org_gap_ticks =
             org_current_gap_size /
             syminfo.mintick

        org_current_is_large_gap :=
             org_gap_ticks >=
             org_large_gap_ticks

        // Prior RTH close.

        org_add_level(
             org_all_lines,
             org_all_labels,
             org_day_line_counts,
             org_day_label_counts,
             org_current_open_time,
             org_active_end_time,
             org_current_close,
             "CLOSE",
             org_close_color,
             org_line_style_txt,
             org_line_width,
             org_show_labels,
             org_label_color,
             org_label_size_txt)

        // Current 9:30 RTH open.

        org_add_level(
             org_all_lines,
             org_all_labels,
             org_day_line_counts,
             org_day_label_counts,
             org_current_open_time,
             org_active_end_time,
             org_current_open,
             "9:30",
             org_open_color,
             org_line_style_txt,
             org_line_width,
             org_show_labels,
             org_label_color,
             org_label_size_txt)

        // Large gaps show 25%.

        if org_current_is_large_gap
            org_add_level(
                 org_all_lines,
                 org_all_labels,
                 org_day_line_counts,
                 org_day_label_counts,
                 org_current_open_time,
                 org_active_end_time,
                 org_25,
                 "25%",
                 org_internal_color,
                 org_line_style_txt,
                 org_line_width,
                 org_show_labels,
                 org_label_color,
                 org_label_size_txt)

        // All valid gaps show 50%.

        org_add_level(
             org_all_lines,
             org_all_labels,
             org_day_line_counts,
             org_day_label_counts,
             org_current_open_time,
             org_active_end_time,
             org_50,
             "50%",
             org_internal_color,
             org_line_style_txt,
             org_line_width,
             org_show_labels,
             org_label_color,
             org_label_size_txt)

        // Large gaps show 75%.

        if org_current_is_large_gap
            org_add_level(
                 org_all_lines,
                 org_all_labels,
                 org_day_line_counts,
                 org_day_label_counts,
                 org_current_open_time,
                 org_active_end_time,
                 org_75,
                 "75%",
                 org_internal_color,
                 org_line_style_txt,
                 org_line_width,
                 org_show_labels,
                 org_label_color,
                 org_label_size_txt)

        // STDVs only exist on large gaps—the same gaps that show 25% and 75%.

        if org_current_is_large_gap
            org_revealed_deviation := 0.5

            org_add_deviation_pair(
                 org_all_lines,
                 org_all_labels,
                 org_day_line_counts,
                 org_day_label_counts,
                 org_current_open_time,
                 org_active_end_time,
                 org_current_range_high,
                 org_current_range_low,
                 org_current_gap_size,
                 org_revealed_deviation,
                 org_up_color,
                 org_down_color,
                 org_dev_style_txt,
                 org_dev_width,
                 org_show_labels,
                 org_label_color,
                 org_label_size_txt)
        else
            org_revealed_deviation := 0.0

        org_delete_old_sessions(
             org_all_lines,
             org_all_labels,
             org_day_line_counts,
             org_day_label_counts,
             org_sessions_to_keep)

// ============================================================================
// KEEP CURRENT ORG EXTENDED TO THE RIGHT BUFFER
// ============================================================================

if org_show and
   org_valid_chart and
   org_current_valid and
   array.size(org_day_line_counts) > 0

    int org_current_line_count =
         array.get(
             org_day_line_counts,
             0)

    if org_current_line_count > 0
        for org_i = 0 to org_current_line_count - 1
            if org_i < array.size(org_all_lines)
                line.set_x2(
                     array.get(
                         org_all_lines,
                         org_i),
                     org_active_end_time)

    int org_current_label_count =
         array.get(
             org_day_label_counts,
             0)

    if org_current_label_count > 0
        for org_i = 0 to org_current_label_count - 1
            if org_i < array.size(org_all_labels)
                label.set_x(
                     array.get(
                         org_all_labels,
                         org_i),
                     org_active_end_time)

// ============================================================================
// PROGRESSIVE STDV REVEAL
// ============================================================================
//
// Touch +0.5 OR -0.5 to reveal +1 and -1.
// Touch +1 OR -1 to reveal +2 and -2.
// Continue in whole-number steps until Maximum STDV.
//
// The touch calculations use the exact same ORG-boundary logic as the lines.

if org_show and
   org_valid_chart and
   org_current_valid and
   org_current_is_large_gap and
   org_revealed_deviation >= 0.5 and
   org_revealed_deviation < org_max_deviation

    bool org_keep_checking = true

    while org_keep_checking and
          org_revealed_deviation < org_max_deviation

        float org_test_upper =
             org_current_range_high +
             (
                 org_current_gap_size *
                 org_revealed_deviation
             )

        float org_test_lower =
             org_current_range_low -
             (
                 org_current_gap_size *
                 org_revealed_deviation
             )

        bool org_upper_touched =
             not na(org_feed_rth_high) and
             org_feed_rth_high >=
             org_test_upper

        bool org_lower_touched =
             not na(org_feed_rth_low) and
             org_feed_rth_low <=
             org_test_lower

        bool org_level_touched =
             org_upper_touched or
             org_lower_touched

        if org_level_touched
            org_revealed_deviation := org_revealed_deviation < 1.0 ? 1.0 : org_revealed_deviation + 1.0

            org_add_deviation_pair(
                 org_all_lines,
                 org_all_labels,
                 org_day_line_counts,
                 org_day_label_counts,
                 org_current_open_time,
                 org_active_end_time,
                 org_current_range_high,
                 org_current_range_low,
                 org_current_gap_size,
                 org_revealed_deviation,
                 org_up_color,
                 org_down_color,
                 org_dev_style_txt,
                 org_dev_width,
                 org_show_labels,
                 org_label_color,
                 org_label_size_txt)
        else
            org_keep_checking := false


// ============================================================================
// =========================== OPENING PRICES ================================
// ============================================================================
// Moved from Bandz Levels. Each scheduled open keeps its original session,
// color, timeframe gate, hard-lock time, label behavior, and history control.

open_group_settings = "Opening Prices - Settings"
open_group_labels   = "Opening Prices - Label Combining"
open_group_prices   = "Opening Prices"

open_history_limit = input.int(
     1,
     "Opening Drawing Limit",
     minval=1,
     maxval=50,
     group=open_group_settings,
     tooltip="Keeps this many records for each enabled opening price unless Unlimited is enabled.")

open_unlimited = input.bool(
     false,
     "Unlimited",
     group=open_group_settings,
     tooltip="Shows as many records for each enabled opening price as TradingView object limits allow.")

open_gmt_tz = input.string(
     "America/New_York",
     "Opening Timezone",
