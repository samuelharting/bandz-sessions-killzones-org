range_size          = bandz_session_text_size(input.string('Normal', "Table Size", options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large', 'Huge'], group = g_RNG))

// ---------------------------------------- State --------------------------------------------------
// A drawing record owns every object and validity flag for one completed or
// forming session. Keeping the objects together prevents history arrays from
// drifting out of alignment when a record is removed.
type BandzSessionDrawing
    box rangeBox
    line highLine
    line midpointLine
    line lowLine
    label highLabel
    label lowLabel
    bool highActive
    bool midpointActive
    bool lowActive
    float highValue
    float lowValue
    float currentRange
    string highText
    string lowText

type BandzSessionBook
    string title
    BandzSessionDrawing[] history
    float[] completedRanges

var BandzSessionBook asiaBook = BandzSessionBook.new(as_txt, array.new<BandzSessionDrawing>(), array.new_float())
var BandzSessionBook londonBook = BandzSessionBook.new(lo_txt, array.new<BandzSessionDrawing>(), array.new_float())
var BandzSessionBook openingRangeBook = BandzSessionBook.new(na_txt, array.new<BandzSessionDrawing>(), array.new_float())
var BandzSessionBook lunchBook = BandzSessionBook.new(nl_txt, array.new<BandzSessionDrawing>(), array.new_float())
var BandzSessionBook premarketBook = BandzSessionBook.new(np_txt, array.new<BandzSessionDrawing>(), array.new_float())
var BandzSessionBook sessionSixBook = BandzSessionBook.new(k6_txt, array.new<BandzSessionDrawing>(), array.new_float())
var BandzSessionBook sessionSevenBook = BandzSessionBook.new(k7_txt, array.new<BandzSessionDrawing>(), array.new_float())

t_as = not na(time("", asia, gmt_tz))
t_lo = not na(time("", london, gmt_tz))
t_na = not na(time("", nyam, gmt_tz))
t_nl = not na(time("", nylu, gmt_tz))
t_np = not na(time("", nypm, gmt_tz))
t_k6 = not na(time("", kz6, gmt_tz))
t_k7 = not na(time("", kz7, gmt_tz))
t_co = not na(time("", cutoff, gmt_tz))

var color bandz_session_transparent = #ffffff00
bool bandz_only_latest = ext_which == "Most Recent"
bool bandz_extend_after_touch = ext_pivots == "Past Mitigation"
bool bandz_session_timeframe_allowed = timeframe.in_seconds("") < timeframe.in_seconds(tf_limit)

bandz_session_fill(color baseColor, int transparency) =>
    color.new(baseColor, transparency)

bandz_session_text_color(color baseColor) =>
    color.new(baseColor, text_transparency)

bandz_session_label_text(string baseText, float price) =>
    label_price ? str.format("{0} ({1})", baseText, price) : baseText

bandz_delete_session_drawing(BandzSessionDrawing drawing) =>
    if not na(drawing.rangeBox)
        box.delete(drawing.rangeBox)
    if not na(drawing.highLine)
        line.delete(drawing.highLine)
    if not na(drawing.midpointLine)
        line.delete(drawing.midpointLine)
    if not na(drawing.lowLine)
        line.delete(drawing.lowLine)
    if not na(drawing.highLabel)
        label.delete(drawing.highLabel)
    if not na(drawing.lowLabel)
        label.delete(drawing.lowLabel)

bandz_trim_session_history(BandzSessionBook book) =>
    while book.history.size() > max_days
        BandzSessionDrawing expired = book.history.pop()
        bandz_delete_session_drawing(expired)

bandz_update_forming_session(BandzSessionBook book, bool active, bool drawPivots, bool drawLabels) =>
    if active and book.history.size() > 0
        BandzSessionDrawing drawing = book.history.get(0)
        bool madeNewHigh = high > drawing.highValue
        bool madeNewLow = low < drawing.lowValue

        drawing.highValue := math.max(drawing.highValue, high)
        drawing.lowValue := math.min(drawing.lowValue, low)
        drawing.currentRange := drawing.highValue - drawing.lowValue

        if not na(drawing.rangeBox)
            box.set_right(drawing.rangeBox, time)
            box.set_top(drawing.rangeBox, drawing.highValue)
            box.set_bottom(drawing.rangeBox, drawing.lowValue)

        if drawPivots and not na(drawing.highLine) and not na(drawing.lowLine)
            if madeNewHigh
                line.set_xy1(drawing.highLine, time, drawing.highValue)
                line.set_xy2(drawing.highLine, time, drawing.highValue)
            else
                line.set_x2(drawing.highLine, time)

            if madeNewLow
                line.set_xy1(drawing.lowLine, time, drawing.lowValue)
                line.set_xy2(drawing.lowLine, time, drawing.lowValue)
            else
                line.set_x2(drawing.lowLine, time)

            if not na(drawing.midpointLine)
                float midpoint = math.avg(drawing.highValue, drawing.lowValue)
                line.set_xy1(drawing.midpointLine, time, midpoint)
                line.set_xy2(drawing.midpointLine, time, midpoint)

        if drawLabels and not na(drawing.highLabel) and not na(drawing.lowLabel)
            if label_right
                label.set_x(drawing.highLabel, time)
                label.set_x(drawing.lowLabel, time)
            if madeNewHigh
                label.set_xy(drawing.highLabel, time, drawing.highValue)
                label.set_text(drawing.highLabel, bandz_session_label_text(drawing.highText, drawing.highValue))
            if madeNewLow
                label.set_xy(drawing.lowLabel, time, drawing.lowValue)
                label.set_text(drawing.lowLabel, bandz_session_label_text(drawing.lowText, drawing.lowValue))

        book.history.set(0, drawing)

bandz_update_completed_sessions(BandzSessionBook book, bool active, bool wasActive, bool drawPivots, bool drawLabels) =>
    if not active and wasActive and book.history.size() > 0 and range_avg > 0
        BandzSessionDrawing completed = book.history.get(0)
        book.completedRanges.unshift(completed.currentRange)
        while book.completedRanges.size() > range_avg
            book.completedRanges.pop()

    if drawPivots and book.history.size() > 0
        int recordsToUpdate = bandz_only_latest ? math.min(1, book.history.size()) : book.history.size()
        if recordsToUpdate > 0
            for index = 0 to recordsToUpdate - 1
                BandzSessionDrawing drawing = book.history.get(index)

                if not na(drawing.highLine)
                    if bandz_extend_after_touch or drawing.highActive
                        line.set_x2(drawing.highLine, time)
                        if drawLabels and label_right and not na(drawing.highLabel)
                            label.set_x(drawing.highLabel, time)

                    if drawing.highActive and high > drawing.highValue
                        drawing.highActive := false
                        if use_alerts and index == 0
                            alert("Broke " + book.title + " High", alert.freq_once_per_bar)
                        if drawLabels and label_right and not na(drawing.highLabel)
                            label.set_style(drawing.highLabel, label.style_label_down)
                    else if drawing.highActive and use_cutoff and t_co
                        drawing.highActive := false

                if not na(drawing.lowLine)
                    if bandz_extend_after_touch or drawing.lowActive
                        line.set_x2(drawing.lowLine, time)
                        if drawLabels and label_right and not na(drawing.lowLabel)
                            label.set_x(drawing.lowLabel, time)

                    if drawing.lowActive and low < drawing.lowValue
                        drawing.lowActive := false
                        if use_alerts and index == 0
                            alert("Broke " + book.title + " Low", alert.freq_once_per_bar)
                        if drawLabels and label_right and not na(drawing.lowLabel)
                            label.set_style(drawing.lowLabel, label.style_label_up)
                    else if drawing.lowActive and use_cutoff and t_co
                        drawing.lowActive := false

                if not active and not na(drawing.midpointLine) and (not stop_midpoints or drawing.midpointActive)
                    line.set_x2(drawing.midpointLine, time)
                    float midpoint = line.get_y1(drawing.midpointLine)
                    if drawing.midpointActive and low <= midpoint and high >= midpoint
                        drawing.midpointActive := false

                book.history.set(index, drawing)

bandz_begin_session(BandzSessionBook book, color sessionColor, string boxText, string highText, string lowText, bool showBox, int boxTransparency, bool drawPivots, bool drawLabels) =>
    color fillColor = bandz_session_fill(sessionColor, boxTransparency)
    color boxTextColor = bandz_session_text_color(sessionColor)
    box rangeBox = na
    if showBox
        rangeBox := box.new(time, high, time, low, xloc = xloc.bar_time, border_color = fillColor, bgcolor = fillColor, text = show_kz_text ? boxText : na, text_color = boxTextColor)

    line highLine = na
    line midpointLine = na
    line lowLine = na
    label highLabel = na
    label lowLabel = na

    if drawPivots
        highLine := line.new(time, high, time, high, xloc = xloc.bar_time, style = kzp_style, color = sessionColor, width = kzp_width)
        lowLine := line.new(time, low, time, low, xloc = xloc.bar_time, style = kzp_style, color = sessionColor, width = kzp_width)
        if show_midpoints
            float midpoint = math.avg(high, low)
            midpointLine := line.new(time, midpoint, time, midpoint, xloc = xloc.bar_time, style = kzm_style, color = sessionColor, width = kzm_width)

        if drawLabels
            string initialHighText = bandz_session_label_text(highText, high)
            string initialLowText = bandz_session_label_text(lowText, low)
            if label_right
                highLabel := label.new(time, high, initialHighText, xloc = xloc.bar_time, color = bandz_session_transparent, textcolor = txt_color, style = label.style_label_left, size = lbl_size)
                lowLabel := label.new(time, low, initialLowText, xloc = xloc.bar_time, color = bandz_session_transparent, textcolor = txt_color, style = label.style_label_left, size = lbl_size)
            else
                highLabel := label.new(time, high, initialHighText, xloc = xloc.bar_time, color = bandz_session_transparent, textcolor = txt_color, style = label.style_label_down, size = lbl_size)
                lowLabel := label.new(time, low, initialLowText, xloc = xloc.bar_time, color = bandz_session_transparent, textcolor = txt_color, style = label.style_label_up, size = lbl_size)

    BandzSessionDrawing drawing = BandzSessionDrawing.new(rangeBox, highLine, midpointLine, lowLine, highLabel, lowLabel, true, true, true, high, low, high - low, highText, lowText)
    book.history.unshift(drawing)
    bandz_trim_session_history(book)

bandz_manage_session(BandzSessionBook book, bool enabled, bool inSession, color sessionColor, string boxText, string highText, string lowText, bool showBox, int boxTransparency, bool sessionPivots, bool sessionLabels) =>
    bool drawPivots = show_pivots and sessionPivots
    bool drawLabels = drawPivots and show_labels and sessionLabels
    bool activeNow = bandz_session_timeframe_allowed and enabled and inSession
    bool activeBefore = bandz_session_timeframe_allowed and enabled and inSession[1]

    if activeNow and not inSession[1]
        bandz_begin_session(book, sessionColor, boxText, highText, lowText, showBox, boxTransparency, drawPivots, drawLabels)

    bandz_update_forming_session(book, activeNow, drawPivots, drawLabels)
    bandz_update_completed_sessions(book, activeNow, activeBefore, drawPivots, drawLabels)

bandz_manage_session(asiaBook, use_asia, t_as, as_color, as_txt, ash_str, asl_str, show_asia_box, asia_box_transp, show_asia_pivots, show_asia_labels)
bandz_manage_session(londonBook, use_london, t_lo, lo_color, lo_txt, loh_str, lol_str, show_london_box, london_box_transp, show_london_pivots, show_london_labels)
bandz_manage_session(openingRangeBook, use_nyam, t_na, na_color, na_txt, nah_str, nal_str, show_nyam_box, nyam_box_transp, show_nyam_pivots, show_nyam_labels)
bandz_manage_session(lunchBook, use_nylu, t_nl, nl_color, nl_txt, nlh_str, nll_str, show_nylu_box, nylu_box_transp, show_nylu_pivots, show_nylu_labels)
bandz_manage_session(premarketBook, use_nypm, t_np, np_color, np_txt, nph_str, npl_str, show_nypm_box, nypm_box_transp, show_nypm_pivots, show_nypm_labels)
bandz_manage_session(sessionSixBook, use_kz6, t_k6, k6_color, k6_txt, k6h_str, k6l_str, show_kz6_box, kz6_box_transp, show_kz6_pivots, show_kz6_labels)
bandz_manage_session(sessionSevenBook, use_kz7, t_k7, k7_color, k7_txt, k7h_str, k7l_str, show_kz7_box, kz7_box_transp, show_kz7_pivots, show_kz7_labels)

bandz_min_completed_samples() =>
    int minimum = na
    if asiaBook.completedRanges.size() > 0
        minimum := asiaBook.completedRanges.size()
    if londonBook.completedRanges.size() > 0
        minimum := na(minimum) ? londonBook.completedRanges.size() : math.min(minimum, londonBook.completedRanges.size())
    if openingRangeBook.completedRanges.size() > 0
        minimum := na(minimum) ? openingRangeBook.completedRanges.size() : math.min(minimum, openingRangeBook.completedRanges.size())
    if lunchBook.completedRanges.size() > 0
        minimum := na(minimum) ? lunchBook.completedRanges.size() : math.min(minimum, lunchBook.completedRanges.size())
    if premarketBook.completedRanges.size() > 0
        minimum := na(minimum) ? premarketBook.completedRanges.size() : math.min(minimum, premarketBook.completedRanges.size())
    if sessionSixBook.completedRanges.size() > 0
        minimum := na(minimum) ? sessionSixBook.completedRanges.size() : math.min(minimum, sessionSixBook.completedRanges.size())
    if sessionSevenBook.completedRanges.size() > 0
        minimum := na(minimum) ? sessionSevenBook.completedRanges.size() : math.min(minimum, sessionSevenBook.completedRanges.size())
    na(minimum) ? 0 : minimum

bandz_current_session_range(BandzSessionBook book) =>
    float result = na
    if book.history.size() > 0
        BandzSessionDrawing current = book.history.get(0)
        result := current.currentRange
    result

bandz_session_table_row(table statsTable, BandzSessionBook book, int row, string rowText, bool enabled, bool active, color rowColor, int rowTransparency) =>
    if enabled
        float currentValue = bandz_current_session_range(book)
        string currentText = na(currentValue) ? "—" : str.tostring(currentValue)
        table.cell(statsTable, 0, row, rowText, text_size = range_size, bgcolor = bandz_session_fill(rowColor, rowTransparency), text_color = txt_color)
        table.cell(statsTable, 1, row, currentText, text_size = range_size, bgcolor = active ? bandz_session_fill(rowColor, rowTransparency) : na, text_color = txt_color)
        if show_range_avg
            float averageValue = book.completedRanges.size() > 0 ? book.completedRanges.avg() : na
            table.cell(statsTable, 2, row, na(averageValue) ? "—" : str.tostring(averageValue), text_size = range_size, text_color = txt_color)

if show_range and bandz_session_timeframe_allowed and barstate.islast
    var table bandzSessionStats = table.new(range_pos, 10, 10, bgcolor = chart.bg_color, frame_color = chart.fg_color, frame_width = 2, border_color = chart.fg_color, border_width = 1)
    table.clear(bandzSessionStats, 0, 0, 9, 9)
    table.cell(bandzSessionStats, 0, 0, "Killzone", text_size = range_size, text_color = txt_color)
    table.cell(bandzSessionStats, 1, 0, "Range", text_size = range_size, text_color = txt_color)
    if show_range_avg
        table.cell(bandzSessionStats, 2, 0, "Avg (" + str.tostring(bandz_min_completed_samples()) + ")", text_size = range_size, text_color = txt_color)

    bandz_session_table_row(bandzSessionStats, asiaBook, 1, as_txt, use_asia, t_as, as_color, asia_box_transp)
    bandz_session_table_row(bandzSessionStats, londonBook, 2, lo_txt, use_london, t_lo, lo_color, london_box_transp)
    bandz_session_table_row(bandzSessionStats, openingRangeBook, 3, na_txt, use_nyam, t_na, na_color, nyam_box_transp)
    bandz_session_table_row(bandzSessionStats, lunchBook, 4, nl_txt, use_nylu, t_nl, nl_color, nylu_box_transp)
    bandz_session_table_row(bandzSessionStats, premarketBook, 5, np_txt, use_nypm, t_np, np_color, nypm_box_transp)
    bandz_session_table_row(bandzSessionStats, sessionSixBook, 6, k6_txt, use_kz6, t_k6, k6_color, kz6_box_transp)
    bandz_session_table_row(bandzSessionStats, sessionSevenBook, 7, k7_txt, use_kz7, t_k7, k7_color, kz7_box_transp)

