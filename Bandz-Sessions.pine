max_days            = input.int(1, "Session Drawing Limit", minval = 1, maxval = 4, tooltip = "Keeps up to four complete drawings per session. The cap covers all seven session books together and leaves drawing headroom for ORG and Opening Range objects under TradingView's 500-object limits.", group = g_SETTINGS)
