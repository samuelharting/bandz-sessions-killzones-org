open_get_line_style(string selection) =>
    switch selection
        "Dotted" => line.style_dotted
        "Dashed" => line.style_dashed
        => line.style_solid

open_get_text_size(string selection) =>
    switch selection
        "Auto"   => size.auto
        "Huge"   => size.huge
        "Large"  => size.large
        "Normal" => size.normal
        "Small"  => size.small
        => size.tiny

open_level_label_text(string baseText, float price) =>
    open_label_price ? str.format("{0} ({1})", baseText, price) : baseText

open_chart_tf_seconds = timeframe.in_seconds(timeframe.period)

open_tf_is_between(string minTf, string maxTf) =>
    float minSeconds = timeframe.in_seconds(minTf)
    float maxSeconds = timeframe.in_seconds(maxTf)
    float lowerBound = math.min(minSeconds, maxSeconds)
    float upperBound = math.max(minSeconds, maxSeconds)
    timeframe.isintraday and open_chart_tf_seconds >= lowerBound and open_chart_tf_seconds <= upperBound

open_h1_tf_ok = open_tf_is_between(open_h1_min_tf, open_h1_max_tf)
open_h2_tf_ok = open_tf_is_between(open_h2_min_tf, open_h2_max_tf)
open_h3_tf_ok = open_tf_is_between(open_h3_min_tf, open_h3_max_tf)
open_h4_tf_ok = open_tf_is_between(open_h4_min_tf, open_h4_max_tf)
open_h5_tf_ok = open_tf_is_between(open_h5_min_tf, open_h5_max_tf)
open_h6_tf_ok = open_tf_is_between(open_h6_min_tf, open_h6_max_tf)
open_h7_tf_ok = open_tf_is_between(open_h7_min_tf, open_h7_max_tf)
open_h8_tf_ok = open_tf_is_between(open_h8_min_tf, open_h8_max_tf)

type OpenTimedMark
    line levelLine
    label levelLabel
    float price
    int eventTime
    int lockTime
    bool locked

type OpenTimedBook
    OpenTimedMark[] records

type OpenLabelInfo
    label lbl
    string baseText
    float basePrice
    int created
    bool active

var OpenTimedBook open_book_one = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_two = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_three = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_four = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_five = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_six = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_seven = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenTimedBook open_book_eight = OpenTimedBook.new(array.new<OpenTimedMark>())
var OpenLabelInfo[] open_master_labels = array.new<OpenLabelInfo>()
var color open_transparent = #ffffff00

open_one_minute_event(string sessionText) =>
    bool inWindow = not na(time("", sessionText, open_gmt_tz))
    bool startsNow = inWindow and not inWindow[1]
    int latestEventTime = ta.valuewhen(startsNow, time, 0)
    float latestEventPrice = ta.valuewhen(startsNow, open, 0)
    [latestEventTime, latestEventPrice]

[open_h1_event_time, open_h1_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h1), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h2_event_time, open_h2_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h2), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h3_event_time, open_h3_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h3), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h4_event_time, open_h4_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h4), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h5_event_time, open_h5_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h5), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h6_event_time, open_h6_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h6), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h7_event_time, open_h7_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h7), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[open_h8_event_time, open_h8_event_price] = request.security(syminfo.tickerid, "1", open_one_minute_event(open_h8), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

open_register_label(float price, string baseText, label lbl) =>
    if not na(lbl) and not na(price)
        bool alreadyRegistered = false
        if array.size(open_master_labels) > 0
            for registryIndex = 0 to array.size(open_master_labels) - 1
                info = array.get(open_master_labels, registryIndex)
                if info.lbl == lbl
                    info.baseText  := baseText
                    info.basePrice := price
                    info.active    := true
                    array.set(open_master_labels, registryIndex, info)
                    alreadyRegistered := true
                    break

        if not alreadyRegistered
            array.push(open_master_labels, OpenLabelInfo.new(lbl, baseText, price, time, true))

open_unregister_label(label lbl) =>
    if not na(lbl) and array.size(open_master_labels) > 0
        for registryIndex = 0 to array.size(open_master_labels) - 1
            info = array.get(open_master_labels, registryIndex)
            if info.active and info.lbl == lbl
                info.active := false
                array.set(open_master_labels, registryIndex, info)
                break

open_prices_are_close(float firstPrice, float secondPrice) =>
    if na(firstPrice) or na(secondPrice)
        false
    else
        float referencePrice = math.max(math.max(math.abs(firstPrice), math.abs(secondPrice)), syminfo.mintick)
        float threshold = referencePrice * (open_combine_threshold / 100.0)
        float epsilon = syminfo.mintick * 0.001
        math.abs(firstPrice - secondPrice) <= threshold + epsilon

open_restore_label_texts() =>
    if array.size(open_master_labels) > 0
        for registryIndex = 0 to array.size(open_master_labels) - 1
            info = array.get(open_master_labels, registryIndex)
            if info.active and not na(info.lbl)
                price = info.basePrice
                if na(price)
                    price := label.get_y(info.lbl)
                if not na(price)
                    label.set_y(info.lbl, price)
                restoredLabelText = open_label_price and not na(price) ? str.format("{0} ({1})", info.baseText, price) : info.baseText
                label.set_text(info.lbl, restoredLabelText)

// Combine close opening labels while keeping the merged text on the
// rightmost real label and at a real opening-price level.
open_combine_persistent_labels() =>
    if not open_combine_labels
        open_restore_label_texts()
        0
    else
        open_restore_label_texts()

        tempLabels  = array.new<label>()
        tempTexts   = array.new_string()
        tempCreated = array.new_int()
        tempPrices  = array.new_float()
        tempX       = array.new_int()

        if array.size(open_master_labels) > 0
            for registryIndex = 0 to array.size(open_master_labels) - 1
                info = array.get(open_master_labels, registryIndex)
                if info.active and not na(info.lbl) and not na(info.basePrice)
                    labelX = label.get_x(info.lbl)
                    if not na(labelX)
                        array.push(tempLabels,  info.lbl)
                        array.push(tempTexts,   info.baseText)
                        array.push(tempCreated, info.created)
                        array.push(tempPrices,  info.basePrice)
                        array.push(tempX,       labelX)

        labelCount = array.size(tempLabels)
        if labelCount > 1
            for sortIndex = 1 to labelCount - 1
                keyPrice   = array.get(tempPrices,  sortIndex)
                keyLabel   = array.get(tempLabels,  sortIndex)
                keyText    = array.get(tempTexts,   sortIndex)
                keyCreated = array.get(tempCreated, sortIndex)
                keyX       = array.get(tempX,       sortIndex)

                sortCursor = sortIndex - 1
                while sortCursor >= 0
                    if array.get(tempPrices, sortCursor) > keyPrice
                        array.set(tempPrices,  sortCursor + 1, array.get(tempPrices,  sortCursor))
                        array.set(tempLabels,  sortCursor + 1, array.get(tempLabels,  sortCursor))
                        array.set(tempTexts,   sortCursor + 1, array.get(tempTexts,   sortCursor))
                        array.set(tempCreated, sortCursor + 1, array.get(tempCreated, sortCursor))
                        array.set(tempX,       sortCursor + 1, array.get(tempX,       sortCursor))
                        sortCursor -= 1
                    else
                        break

                array.set(tempPrices,  sortCursor + 1, keyPrice)
                array.set(tempLabels,  sortCursor + 1, keyLabel)
                array.set(tempTexts,   sortCursor + 1, keyText)
                array.set(tempCreated, sortCursor + 1, keyCreated)
                array.set(tempX,       sortCursor + 1, keyX)

            clusterIndex = 0
            while clusterIndex < labelCount
                previousPrice = array.get(tempPrices, clusterIndex)
                memberCount   = 1
                combinedText  = array.get(tempTexts, clusterIndex)

                primaryIndex   = clusterIndex
                primaryCreated = array.get(tempCreated, clusterIndex)
                primaryX       = array.get(tempX, clusterIndex)

                members = array.new_int()
                array.push(members, clusterIndex)

                nextIndex = clusterIndex + 1
                while nextIndex < labelCount
                    candidatePrice = array.get(tempPrices, nextIndex)
                    if not open_prices_are_close(previousPrice, candidatePrice)
                        break

                    combinedText := combinedText + " / " + array.get(tempTexts, nextIndex)
                    memberCount += 1
                    previousPrice := candidatePrice

                    candidateX = array.get(tempX, nextIndex)
                    candidateCreated = array.get(tempCreated, nextIndex)

                    if (not na(candidateX) and (na(primaryX) or candidateX > primaryX)) or ((not na(candidateX) and not na(primaryX) and candidateX == primaryX) and candidateCreated < primaryCreated)
                        primaryX       := candidateX
                        primaryIndex   := nextIndex
                        primaryCreated := candidateCreated
                    else if na(primaryX) and candidateCreated < primaryCreated
                        primaryCreated := candidateCreated
                        primaryIndex   := nextIndex

                    array.push(members, nextIndex)
                    nextIndex += 1

                if memberCount > 1
                    for memberIndex = 0 to array.size(members) - 1
                        sortedIndex = array.get(members, memberIndex)
                        currentLabel = array.get(tempLabels, sortedIndex)

                        if sortedIndex == primaryIndex
                            primaryPrice = array.get(tempPrices, primaryIndex)
                            mergedText = open_label_price ? str.format("{0} ({1})", combinedText, primaryPrice) : combinedText
                            label.set_text(currentLabel, mergedText)
                            if not na(primaryPrice)
                                label.set_y(currentLabel, primaryPrice)
                        else
                            label.set_text(currentLabel, "")

                clusterIndex := nextIndex

        0

open_delete_mark(OpenTimedMark mark) =>
    if not na(mark.levelLine)
        line.delete(mark.levelLine)
    if not na(mark.levelLabel)
        open_unregister_label(mark.levelLabel)
        label.delete(mark.levelLabel)

open_trim_book(OpenTimedBook book) =>
    if not open_unlimited
        while book.records.size() > open_history_limit
            OpenTimedMark expired = book.records.pop()
            open_delete_mark(expired)

open_session_start_minutes(string sessionText) =>
    int hoursPart = int(str.tonumber(str.substring(sessionText, 0, 2)))
    int minutesPart = int(str.tonumber(str.substring(sessionText, 2, 4)))
    hoursPart * 60 + minutesPart

open_lock_time(int openingTime, string lockSession) =>
    int openingMinute = hour(openingTime, open_gmt_tz) * 60 + minute(openingTime, open_gmt_tz)
    int lockMinuteOfDay = open_session_start_minutes(lockSession)
    int targetHour = int(math.floor(lockMinuteOfDay / 60))
    int targetMinute = lockMinuteOfDay % 60
    int calendarOffset = lockMinuteOfDay <= openingMinute ? 1 : 0
    timestamp(open_gmt_tz, year(openingTime, open_gmt_tz), month(openingTime, open_gmt_tz), dayofmonth(openingTime, open_gmt_tz) + calendarOffset, targetHour, targetMinute)

open_endpoint(int eventTime, int lockTime) =>
    int millisecondsPerBar = int(math.max(1000.0, open_chart_tf_seconds * 1000.0))
    int projectionBase = math.max(time, eventTime)
    int bufferedTarget = projectionBase + open_right_buffer * millisecondsPerBar
    math.max(eventTime, math.min(bufferedTarget, lockTime))

open_label_x(int lockTime) =>
    int millisecondsPerBar = int(math.max(1000.0, open_chart_tf_seconds * 1000.0))
    int barsUntilLock = lockTime > time ? int(math.ceil((lockTime - time) / millisecondsPerBar)) : 0
    bar_index + math.min(open_right_buffer, math.max(barsUntilLock, 0))

open_sync_timed_price(OpenTimedBook book, bool enabled, int eventTime, float eventPrice, string levelText, color levelColor, string lockSession) =>
    if enabled and not na(eventTime) and not na(eventPrice)
        bool unseenEvent = book.records.size() == 0
        if not unseenEvent
            OpenTimedMark latest = book.records.get(0)
            unseenEvent := latest.eventTime != eventTime

        if unseenEvent
            int lockTime = open_lock_time(eventTime, lockSession)
            int firstEndpoint = open_endpoint(eventTime, lockTime)
            int firstLabelX = open_label_x(lockTime)
            line newLine = line.new(eventTime, eventPrice, firstEndpoint, eventPrice, xloc=xloc.bar_time, style=open_get_line_style(open_hz_style_txt), width=open_hz_width, color=levelColor)
            label newLabel = label.new(firstLabelX, eventPrice, open_level_label_text(levelText, eventPrice), xloc=xloc.bar_index, style=label.style_label_left, color=open_transparent, textcolor=open_txt_color, size=open_get_text_size(open_label_size_txt))
            OpenTimedMark mark = OpenTimedMark.new(newLine, newLabel, eventPrice, eventTime, lockTime, false)
            book.records.unshift(mark)
            open_register_label(eventPrice, levelText, newLabel)
            open_trim_book(book)

        if book.records.size() > 0
            for index = 0 to book.records.size() - 1
                OpenTimedMark mark = book.records.get(index)
                if not mark.locked
                    int endpoint = open_endpoint(mark.eventTime, mark.lockTime)
                    int labelX = open_label_x(mark.lockTime)
                    line.set_x2(mark.levelLine, endpoint)
                    line.set_color(mark.levelLine, levelColor)
                    line.set_style(mark.levelLine, open_get_line_style(open_hz_style_txt))
                    line.set_width(mark.levelLine, open_hz_width)
                    label.set_x(mark.levelLabel, labelX)
                    label.set_y(mark.levelLabel, mark.price)
                    label.set_text(mark.levelLabel, open_level_label_text(levelText, mark.price))
                    label.set_textcolor(mark.levelLabel, open_txt_color)
                    label.set_size(mark.levelLabel, open_get_text_size(open_label_size_txt))

                    if time >= mark.lockTime
                        mark.locked := true
                    book.records.set(index, mark)

open_render_prices() =>
    open_sync_timed_price(open_book_one, open_use_h1 and open_h1_tf_ok, open_h1_event_time, open_h1_event_price, open_h1_text, open_h1_color, open_h1_lock)
    open_sync_timed_price(open_book_two, open_use_h2 and open_h2_tf_ok, open_h2_event_time, open_h2_event_price, open_h2_text, open_h2_color, open_h2_lock)
    open_sync_timed_price(open_book_three, open_use_h3 and open_h3_tf_ok, open_h3_event_time, open_h3_event_price, open_h3_text, open_h3_color, open_h3_lock)
    open_sync_timed_price(open_book_four, open_use_h4 and open_h4_tf_ok, open_h4_event_time, open_h4_event_price, open_h4_text, open_h4_color, open_h4_lock)
    open_sync_timed_price(open_book_five, open_use_h5 and open_h5_tf_ok, open_h5_event_time, open_h5_event_price, open_h5_text, open_h5_color, open_h5_lock)
    open_sync_timed_price(open_book_six, open_use_h6 and open_h6_tf_ok, open_h6_event_time, open_h6_event_price, open_h6_text, open_h6_color, open_h6_lock)
    open_sync_timed_price(open_book_seven, open_use_h7 and open_h7_tf_ok, open_h7_event_time, open_h7_event_price, open_h7_text, open_h7_color, open_h7_lock)
    open_sync_timed_price(open_book_eight, open_use_h8 and open_h8_tf_ok, open_h8_event_time, open_h8_event_price, open_h8_text, open_h8_color, open_h8_lock)

open_render_prices()

if barstate.islast
    open_combine_persistent_labels()

// ============================================================================
// ================ REORGANIZED: OPENING RANGE BAR ===========================
// ============================================================================
// This is the independent Opening Range bracket from the original macro module.
isOpeningRangeTF = timeframe.isminutes and timeframe.multiplier >= 1 and timeframe.multiplier <= 5
oneBarMS = time_close - time
noColor = color.new(#ffffff, 100)

orGroup            = "Opening Range Bar"
showOpeningRange   = input.bool(false, "Show Opening Range", group=orGroup)
openingRangeTime   = input.session("0930-1000", "Range Time", group=orGroup, tooltip="Default is 9:30 AM-10:00 AM. Times use the selected time zone.")
orTimezoneInput    = input.string("America/New_York", "Time Zone", options=["America/New_York", "America/Chicago", "Europe/London", "Etc/UTC", "Exchange"], group=orGroup)
orWeekdaysOnly     = input.bool(false, "Weekdays Only", group=orGroup)
orLabelText        = input.string("", "Label", group=orGroup)
orShowLabel        = input.bool(false, "Show Label", inline="orLabel", group=orGroup)
orShowTime         = input.bool(false, "Include Time", inline="orLabel", group=orGroup)
orColor            = input.color(color.rgb(74, 74, 74), "Color", inline="orLine", group=orGroup)
orLineStyleInput   = input.string("Solid", "Style", options=["Solid", "Dashed", "Dotted"], inline="orLine", group=orGroup)
orLineWidth        = input.int(1, "Width", minval=1, maxval=4, inline="orLine", group=orGroup)
orShowProjections  = input.bool(false, "Edge Projections", group=orGroup, tooltip="Draws dotted lines from the candles to the two ends of the Opening Range bracket.")
orVerticalOffset   = input.int(50, "Vertical Offset (ticks)", minval=1, group=orGroup)
orLegLength        = input.int(10, "Bracket Leg Length (ticks)", minval=1, group=orGroup)
orLabelSize        = input.string(size.small, "Label Size", options=[size.tiny, size.small, size.normal, size.large], group=orGroup)
orMaxDays          = input.int(10, "Days To Keep", minval=1, maxval=50, group=orGroup)

string openingRangeTimezone = orTimezoneInput == "Exchange" ? syminfo.timezone : orTimezoneInput
string openingRangeSession  = openingRangeTime + (orWeekdaysOnly ? ":23456" : ":1234567")
bool openingRangeActive     = not na(time(timeframe.period, openingRangeSession, openingRangeTimezone))
int openingRangeLookback    = isOpeningRangeTF ? math.max(1, int(math.ceil(timeframe.in_seconds("15") / timeframe.in_seconds(timeframe.period)))) : 1
float openingRangeTop       = ta.highest(high, openingRangeLookback) + syminfo.mintick * orVerticalOffset
string openingRangeClock    = str.substring(openingRangeTime, 0, 2) + ":" + str.substring(openingRangeTime, 2, 4) + " - " + str.substring(openingRangeTime, 5, 7) + ":" + str.substring(openingRangeTime, 7, 9)
string openingRangeLabel    = orShowTime ? orLabelText + " " + openingRangeClock : orLabelText
string orLineStyle = switch orLineStyleInput
    "Dashed" => line.style_dashed
    "Dotted" => line.style_dotted
    => line.style_solid

var line[]  OPENING_RANGE_LINES  = array.new_line()
var line[]  OPENING_RANGE_EXT    = array.new_line()
var label[] OPENING_RANGE_LABELS = array.new_label()

openingRangeBar(line[] lines, line[] projections, label[] labels, bool active) =>
    float leg = syminfo.mintick * orLegLength
    float pad = syminfo.mintick * orVerticalOffset

    if bar_index > 0 and not active[1] and active
        line startLeg = line.new(time, openingRangeTop - leg, time, openingRangeTop, xloc=xloc.bar_time, color=orColor, style=orLineStyle, width=orLineWidth)
        line topLine  = line.new(time, openingRangeTop, time + oneBarMS, openingRangeTop, xloc=xloc.bar_time, color=orColor, style=orLineStyle, width=orLineWidth)
        lines.push(startLeg)
        lines.push(topLine)

        if orShowProjections
            projections.push(line.new(time, high, time, openingRangeTop, xloc=xloc.bar_time, color=orColor, style=line.style_dotted, width=orLineWidth))

        labels.push(label.new(time, openingRangeTop, orShowLabel ? openingRangeLabel : "", tooltip=openingRangeLabel, xloc=xloc.bar_time, style=label.style_label_down, color=noColor, textcolor=orColor, size=orLabelSize))

    if active and lines.size() >= 2 and labels.size() > 0
        line startLeg = lines.get(lines.size() - 2)
        line topLine  = lines.last()
        label rangeLabel = labels.last()
        float newTop = math.max(topLine.get_y1(), high + pad)

        startLeg.set_y1(newTop - leg)
        startLeg.set_y2(newTop)
        startLeg.set_color(orColor)
        startLeg.set_style(orLineStyle)
        startLeg.set_width(orLineWidth)

        topLine.set_y1(newTop)
        topLine.set_y2(newTop)
        topLine.set_x2(time + oneBarMS)
        topLine.set_color(orColor)
        topLine.set_style(orLineStyle)
        topLine.set_width(orLineWidth)

        rangeLabel.set_x(math.round(math.avg(startLeg.get_x1(), time + oneBarMS)))
        rangeLabel.set_y(newTop)
        rangeLabel.set_text(orShowLabel ? openingRangeLabel : "")
        rangeLabel.set_textcolor(orColor)
        rangeLabel.set_size(orLabelSize)

        if orShowProjections and projections.size() > 0
            projections.last().set_y1(high)
            projections.last().set_y2(newTop)
            projections.last().set_color(orColor)
            projections.last().set_width(orLineWidth)

    if bar_index > 0 and active[1] and not active and lines.size() >= 2 and labels.size() > 0
        line topLine = lines.last()
        float finalTop = topLine.get_y1()
        line endLeg = line.new(time, finalTop - leg, time, finalTop, xloc=xloc.bar_time, color=orColor, style=orLineStyle, width=orLineWidth)
        lines.push(endLeg)

        labels.last().set_x(math.round(math.avg(lines.get(lines.size() - 3).get_x1(), time)))
        labels.last().set_y(finalTop)

        if orShowProjections
            projections.push(line.new(time, high[1], time, finalTop, xloc=xloc.bar_time, color=orColor, style=line.style_dotted, width=orLineWidth))

    // Each completed bracket has three lines, up to two projections, and one label.
    while labels.size() > orMaxDays
        labels.shift().delete()
        for i = 0 to 2
            if lines.size() > 0
                lines.shift().delete()
        for i = 0 to 1
            if projections.size() > 0
                projections.shift().delete()


// The Opening Range bracket is rendered on minute chart timeframes from 1
// through 5 minutes.
if showOpeningRange and isOpeningRangeTF
    openingRangeBar(OPENING_RANGE_LINES, OPENING_RANGE_EXT, OPENING_RANGE_LABELS, openingRangeActive)

// ============================================================================
// ======================= BANDZ SESSION RANGE ENGINE =========================
// ============================================================================
// Original Bandz implementation of the author's configurable session-range,
// pivot, mitigation, alert, and range-statistics rules. This implementation
// does not import or reuse third-party Pine source.

bandz_session_line_style(string selection) =>
    switch selection
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

bandz_session_text_size(string selection) =>
    switch selection
        "Auto"   => size.auto
        "Huge"   => size.huge
        "Large"  => size.large
        "Normal" => size.normal
        "Small"  => size.small
        => size.tiny

bandz_session_table_position(string selection) =>
    result = position.top_right
    if selection == "Top Left"
        result := position.top_left
    else if selection == "Top Center"
        result := position.top_center
    else if selection == "Middle Right"
        result := position.middle_right
    else if selection == "Middle Left"
        result := position.middle_left
    else if selection == "Middle Center"
        result := position.middle_center
    else if selection == "Bottom Right"
        result := position.bottom_right
    else if selection == "Bottom Left"
        result := position.bottom_left
    else if selection == "Bottom Center"
        result := position.bottom_center
    result

// ---------------------------------------- Inputs --------------------------------------------------
